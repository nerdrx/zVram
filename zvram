#!/usr/bin/env python3
"""Launch one process with the local zVram Vulkan or HIP backend."""
import argparse
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True

if sys.argv[1:] == ["--version"]:
    print("zVram " + (Path(__file__).resolve().parent / "VERSION").read_text().strip())
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] in ("gui", "tui", "manage", "model", "run"):
    if sys.argv[1] == "model":
        import zvram_model
        sys.argv = [str(Path(__file__).resolve().parent / "zvram_model.py"), *sys.argv[2:]]
        sys.exit(zvram_model.main())
    import zvram_manager
    try:
        sys.exit(zvram_manager.main(sys.argv[1:] if sys.argv[1] in ("gui", "tui", "run") else sys.argv[2:]))
    except (OSError, ValueError, KeyError, RuntimeError) as exc:
        sys.exit("zVram manager: " + str(exc))

parser = argparse.ArgumentParser(description="zVram experimental GPU memory launcher")
live_control = parser.add_mutually_exclusive_group()
live_control.add_argument("--live-control", action="store_true", default=None, help="enable live residency controls (default for Vulkan)")
live_control.add_argument("--no-live-control", action="store_false", dest="live_control", help="disable automatic paging defaults; keep explicit Vulkan settings")
parser.add_argument("--build-dir", type=Path, help="use backend files from this CMake build directory (default: local build/)")
parser.add_argument("--hip", action="store_true", help="use the HIP allocation spillover backend instead of the Vulkan layer")
parser.add_argument("--hip-vmm", action="store_true", help="use HIP virtual memory for a single pointer backed by VRAM and RAM (experimental)")
parser.add_argument("--hip-report-capacity", action="store_true", help="report the configured VRAM plus GTT capacity through supported HIP queries (opt-in)")
parser.add_argument("--hip-local-mib", type=int, help="spill tracked HIP allocations beyond this local limit; 0 forces RAM backing")
parser.add_argument("--hip-host-mib", type=int, help="limit tracked mapped HIP host memory")
parser.add_argument("--hip-auto-idle-ms", type=int, help="automatically compress idle HIP VMM allocations (experimental, exact supported HIP ABI)")
parser.add_argument("--hip-cold-mib", type=int, help="limit automatic lossless cold storage; requires --hip-auto-idle-ms")
virtual_size = parser.add_mutually_exclusive_group()
virtual_size.add_argument("--vulkan-virtual-mib", type=int, help="set the experimental Vulkan logical heap size at launch, in positive MiB (requires sparse binding)")
virtual_size.add_argument("--vulkan-virtual-gib", type=int, help="set the experimental Vulkan logical heap size at launch, in positive GiB (requires sparse binding)")
parser.add_argument("--vulkan-auto-idle-ms", type=int, help="compress eligible idle Vulkan storage allocations after this delay (experimental)")
parser.add_argument("--vulkan-cold-mib", type=int, help="limit retained Vulkan snapshots in MiB; requires --vulkan-auto-idle-ms")
parser.add_argument("--vulkan-min-savings-percent", type=int, help="minimum snapshot savings 0..100; 0 keeps any saving, 100 uses raw snapshots; requires automatic snapshots")
parser.add_argument("--vulkan-byte-shuffle", type=int, choices=(2,4), help="losslessly reorder byte planes before Zstd; requires automatic snapshots (experimental)")
parser.add_argument("--vulkan-codec", choices=("zstd", "gdeflate", "bp16"), help="snapshot codec (default zstd); GDeflate and BP16 are experimental optional codecs")
parser.add_argument("--vulkan-gdeflate-workers", type=int, choices=range(1,33), help="bounded CPU GDeflate encoding workers (default 1); requires the GDeflate codec and automatic snapshots")
parser.add_argument("--vulkan-bp16-workers", type=int, choices=range(1,33), help="bounded CPU BP16 encoding workers (default 1); requires the BP16 codec and automatic snapshots")
parser.add_argument("--vulkan-bp16-upload-workers", type=int, choices=range(1,9), help="bounded BP16 GPU upload-copy workers (default 1); requires BP16 GPU restore")
parser.add_argument("--vulkan-gdeflate-gpu", action="store_true", help="restore GDeflate snapshots directly on a supported wave32 GPU (experimental, CPU fallback)")
parser.add_argument("--vulkan-bp16-gpu", action="store_true", help="restore BP16 snapshots directly on a supported GPU (experimental, CPU fallback)")
parser.add_argument("--vulkan-selective-restore", action="store_true", help="restore only allocations referenced by tracked Vulkan submissions; unknown access restores all (experimental)")
parser.add_argument("--vulkan-active-eviction", action="store_true", help="compress unused whole Vulkan allocations while other tracked submissions remain active; requires selective restore (experimental)")
parser.add_argument("--vulkan-async-compression", action="store_true", help="encode one eligible idle range of at most 32 MiB outside submission locks; requires active range paging (experimental)")
parser.add_argument("--vulkan-buffer-presentation", action="store_true", help="retain buffer paging across base Vulkan presents with no pNext; requires active eviction (experimental, native images remain unpaged)")
parser.add_argument("--vulkan-range-mib", type=int, help="enable sparse residency and chunk native pools at this positive MiB granularity; requires active eviction (experimental)")
parser.add_argument("--vulkan-resident-mib", type=int, help="limit eligible resident backing at tracked submission admission; requires range mode (experimental, not a global VRAM cap)")
parser.add_argument("--vulkan-headroom-mib", type=int, help="tighten the backing cap using native memory_budget and this positive MiB reserve; requires lazy backing (experimental)")
parser.add_argument("--vulkan-lazy-backing", action="store_true", help="defer pristine range backing until admitted use; requires immediate resident admission (experimental)")
parser.add_argument("--vulkan-resident-after-cold", action="store_true", help="arm resident admission after all eligible backing first becomes cold; startup can exceed limit")
parser.add_argument("--vulkan-eviction-policy", choices=("lru", "mru"), help="choose pressure victims: oldest first (default lru), or newest first for cyclic scans; requires resident admission")
parser.add_argument("--vulkan-strict-robustness", action="store_true", help="enable supported robustness2 bounds for narrow descriptor residency; requires range mode")
parser.add_argument("--vulkan-clean-cache", action="store_true", help="reuse retained snapshots after proven read-only work; shares cold-store budget and requires range mode")
parser.add_argument("--vulkan-clean-cache-mib", type=int, help="cap expendable clean snapshot cache in MiB; requires --vulkan-clean-cache and cannot exceed --vulkan-cold-mib")
parser.add_argument("--verbose", action="store_true", help="log each Vulkan allocation")
parser.add_argument("--validate", action="store_true", help="enable Vulkan core and synchronization validation")
parser.add_argument("--isolate-layers", action="store_true", help="disable implicit layers for a controlled experiment")
parser.add_argument("command", nargs=argparse.REMAINDER, help="-- application [arguments]")
args = parser.parse_args()
if args.live_control is None:
    args.live_control = not args.hip
if args.live_control:
    if args.hip:
        parser.error('--live-control currently requires the Vulkan backend')
    from zvram_manager import gpu_status
    if args.vulkan_virtual_gib is None and args.vulkan_virtual_mib is None:
        args.vulkan_virtual_gib = 96
    defaults = dict(vulkan_auto_idle_ms=1000, vulkan_cold_mib=4096, vulkan_range_mib=32,
                    vulkan_resident_mib=max(256, int(max((c['vram_total_mib'] for c in gpu_status()), default=8192) * .5)),
                    vulkan_headroom_mib=1536)
    for key, value in defaults.items():
        if getattr(args, key) is None:
            setattr(args, key, value)
    args.vulkan_selective_restore = args.vulkan_active_eviction = args.vulkan_lazy_backing = True
if args.vulkan_virtual_gib is not None:
    args.vulkan_virtual_mib = args.vulkan_virtual_gib * 1024
command = args.command
if command and command[0] == "--":
    command = command[1:]
if not command:
    parser.error("supply an application after --")
build = args.build_dir.expanduser().resolve() if args.build_dir else Path(__file__).resolve().parent / "build"
if args.hip and args.validate:
    parser.error("--validate applies to the Vulkan backend")
if args.vulkan_virtual_mib is not None:
    if args.hip or args.vulkan_virtual_mib <= 0:
        parser.error("--vulkan-virtual-mib requires the Vulkan backend and a positive size in MiB")
    if args.vulkan_virtual_mib > ((1 << 64) - 1) // (1024 * 1024):
        parser.error("--vulkan-virtual-mib overflows Vulkan's 64-bit byte size")
if args.vulkan_auto_idle_ms is not None:
    if args.hip or args.vulkan_virtual_mib is None or args.vulkan_cold_mib is None or not 1 <= args.vulkan_auto_idle_ms <= (1 << 32) - 1:
        parser.error("Vulkan automatic snapshots require --vulkan-virtual-mib, --vulkan-cold-mib, and idle a positive uint32 in ms")
if args.vulkan_min_savings_percent is not None and (
        args.hip or args.vulkan_auto_idle_ms is None or
        not 0 <= args.vulkan_min_savings_percent <= 100):
    parser.error("--vulkan-min-savings-percent requires Vulkan automatic snapshots and a value 0..100")
if args.vulkan_cold_mib is not None:
    if args.vulkan_auto_idle_ms is None or not 0 < args.vulkan_cold_mib <= ((1 << 64) - 1) // (1024 * 1024):
        parser.error("--vulkan-cold-mib requires automatic snapshots and a positive size fitting 64-bit bytes")
if args.vulkan_byte_shuffle is not None and (args.hip or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-byte-shuffle requires Vulkan automatic snapshots")
if args.vulkan_codec is not None and (args.hip or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-codec requires Vulkan automatic snapshots")
effective_codec = args.vulkan_codec or os.environ.get("ZVRAM_VULKAN_CODEC", "zstd")
if args.vulkan_gdeflate_workers is not None and (args.hip or args.vulkan_auto_idle_ms is None or effective_codec != "gdeflate"):
    parser.error("--vulkan-gdeflate-workers requires the GDeflate codec and Vulkan automatic snapshots")
if args.vulkan_bp16_workers is not None and (args.hip or args.vulkan_auto_idle_ms is None or effective_codec != "bp16"):
    parser.error("--vulkan-bp16-workers requires the BP16 codec and Vulkan automatic snapshots")
gdeflate_gpu = args.vulkan_gdeflate_gpu or os.environ.get("ZVRAM_VULKAN_GDEFLATE_GPU") == "1"
bp16_gpu = args.vulkan_bp16_gpu or os.environ.get("ZVRAM_VULKAN_BP16_GPU") == "1"
if gdeflate_gpu and bp16_gpu:
    parser.error("GPU GDeflate and BP16 restore are mutually exclusive")
gpu_restore = gdeflate_gpu or bp16_gpu
if not args.hip and gdeflate_gpu and (effective_codec != "gdeflate" or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-gdeflate-gpu requires the gdeflate codec and Vulkan automatic snapshots")
if not args.hip and bp16_gpu and (effective_codec != "bp16" or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-bp16-gpu requires the bp16 codec and Vulkan automatic snapshots")
if args.vulkan_bp16_upload_workers is not None and (
        args.hip or not bp16_gpu or effective_codec != "bp16" or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-bp16-upload-workers requires BP16 GPU restore and Vulkan automatic snapshots")
if args.hip and args.vulkan_gdeflate_gpu:
    parser.error("--vulkan-gdeflate-gpu requires the Vulkan backend")
if args.hip and (args.vulkan_bp16_gpu or os.environ.get("ZVRAM_VULKAN_BP16_GPU") == "1" or effective_codec == "bp16"):
    parser.error("BP16 codec and GPU restore require the Vulkan backend")
if not args.hip and effective_codec not in ("zstd", "gdeflate", "bp16"):
    parser.error("invalid inherited ZVRAM_VULKAN_CODEC; expected zstd, gdeflate, or bp16")
if not args.hip and effective_codec == "gdeflate":
    if args.vulkan_byte_shuffle is not None or os.environ.get("ZVRAM_VULKAN_BYTE_SHUFFLE") is not None:
        parser.error("--vulkan-byte-shuffle requires the zstd codec")
    try:
        codecs = json.loads((build / "zvram-codecs.json").read_text())
    except (OSError, ValueError):
        codecs = {}
    if not isinstance(codecs, dict) or codecs.get("gdeflate") is not True:
        parser.error("GDeflate codec missing; rebuild with -DZVRAM_ENABLE_GDEFLATE=ON")
    if gpu_restore and (codecs.get("gdeflate_gpu") is not True or not (build / "gdeflate-wave32.spv").is_file()):
        parser.error("GPU GDeflate decoder missing; rebuild with -DZVRAM_ENABLE_GDEFLATE=ON")
if not args.hip and effective_codec == "bp16":
    if args.vulkan_auto_idle_ms is None:
        parser.error("BP16 codec requires Vulkan automatic snapshots")
    if args.vulkan_byte_shuffle is not None or os.environ.get("ZVRAM_VULKAN_BYTE_SHUFFLE") is not None:
        parser.error("--vulkan-byte-shuffle requires the zstd codec")
    try:
        codecs = json.loads((build / "zvram-codecs.json").read_text())
    except (OSError, ValueError):
        codecs = {}
    if not isinstance(codecs, dict) or codecs.get("bp16") is not True:
        parser.error("BP16 codec missing from this build")
    if bp16_gpu and (codecs.get("bp16_gpu") is not True or not (build / "bp16.spv").is_file()):
        parser.error("GPU BP16 decoder missing from this build")
if args.vulkan_selective_restore and (args.hip or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-selective-restore requires Vulkan automatic snapshots")
if args.vulkan_active_eviction and not args.vulkan_selective_restore:
    parser.error("--vulkan-active-eviction requires --vulkan-selective-restore")
if args.vulkan_range_mib is not None and (not args.vulkan_active_eviction or
        not 0 < args.vulkan_range_mib <= ((1 << 64) - 1) // (1024 * 1024)):
    parser.error("--vulkan-range-mib requires active eviction and a positive size fitting 64-bit bytes")
if args.vulkan_resident_mib is not None and (args.vulkan_range_mib is None or
        not 0 < args.vulkan_resident_mib <= ((1 << 64) - 1) // (1024 * 1024)):
    parser.error("--vulkan-resident-mib requires range mode and a positive size fitting 64-bit bytes")
if args.vulkan_lazy_backing and (args.hip or args.vulkan_resident_mib is None or args.vulkan_resident_after_cold):
    parser.error("--vulkan-lazy-backing requires immediate --vulkan-resident-mib admission")
if args.vulkan_async_compression and (args.hip or args.vulkan_range_mib is None):
    parser.error("--vulkan-async-compression requires Vulkan active range paging")
if args.vulkan_buffer_presentation and (args.hip or not args.vulkan_active_eviction):
    parser.error("--vulkan-buffer-presentation requires Vulkan active eviction")
if args.vulkan_headroom_mib is not None and (args.hip or not args.vulkan_lazy_backing or
        not 0 < args.vulkan_headroom_mib <= ((1 << 64) - 1) // (1024 * 1024)):
    parser.error("--vulkan-headroom-mib requires lazy backing and a positive size fitting 64-bit bytes")
if args.vulkan_strict_robustness and args.vulkan_range_mib is None:
    parser.error("--vulkan-strict-robustness requires --vulkan-range-mib")
if args.vulkan_resident_after_cold and args.vulkan_resident_mib is None:
    parser.error("--vulkan-resident-after-cold requires --vulkan-resident-mib")
if args.vulkan_eviction_policy is not None and args.vulkan_resident_mib is None:
    parser.error("--vulkan-eviction-policy requires --vulkan-resident-mib")
if args.vulkan_clean_cache and args.vulkan_range_mib is None:
    parser.error("--vulkan-clean-cache requires --vulkan-range-mib")
if args.vulkan_clean_cache_mib is not None and (
        args.hip or not args.vulkan_clean_cache or args.vulkan_range_mib is None or
        args.vulkan_cold_mib is None or not 0 < args.vulkan_clean_cache_mib <= ((1 << 64) - 1) // (1024 * 1024) or
        args.vulkan_clean_cache_mib > args.vulkan_cold_mib):
    parser.error("--vulkan-clean-cache-mib requires clean cache, range mode, and a positive size no larger than --vulkan-cold-mib")
if not args.hip and (args.hip_vmm or args.hip_report_capacity or args.hip_local_mib is not None or args.hip_host_mib is not None or args.hip_auto_idle_ms is not None or args.hip_cold_mib is not None):
    parser.error("HIP virtual memory and memory limits require --hip")
if args.hip_report_capacity and (not args.hip_vmm or args.hip_local_mib is None or
                                 args.hip_host_mib is None or args.hip_host_mib <= 0):
    parser.error("--hip-report-capacity requires --hip-vmm and explicit local and positive host limits")
if args.hip_auto_idle_ms is not None and (not args.hip_vmm or args.hip_cold_mib is None or
                                       args.hip_local_mib is None or args.hip_host_mib is None or
                                       not 1 <= args.hip_auto_idle_ms <= 60000 or
                                       not 1 <= args.hip_cold_mib <= 40960):
    parser.error("automatic hibernation requires --hip-vmm, explicit local/host limits, idle 1..60000 ms, and cold storage 1..40960 MiB")
if args.hip_cold_mib is not None and args.hip_auto_idle_ms is None:
    parser.error("--hip-cold-mib requires --hip-auto-idle-ms")
for limit in (args.hip_local_mib, args.hip_host_mib):
    if limit is not None and not 0 <= limit <= 40960:
        parser.error("HIP memory limits must be 0..40960 MiB")
if args.hip and not (build / "libzvram_hip.so").is_file():
    parser.error("HIP backend missing; install ROCm development tools and rebuild")
if not args.hip and (not (build / "VK_LAYER_NX_zvram.json").is_file() or not (build / "libzvram_layer.so").is_file()):
    parser.error("build first: cmake -S zvram -B zvram/build && cmake --build zvram/build")
env = os.environ.copy()
if not args.hip:
    import zvram_control
    env['ZVRAM_CONTROL_DIR'] = str(zvram_control.directory())
    # Steam imports the layer but isolates /run/user; export only our private IPC directory.
    exported = env['ZVRAM_CONTROL_DIR'].replace('\\', '\\\\').replace(':', '\\:')
    existing = env.get('PRESSURE_VESSEL_FILESYSTEMS_RW', '')
    env['PRESSURE_VESSEL_FILESYSTEMS_RW'] = existing + (':' if existing else '') + exported
if args.hip:
    # The loader accepts spaces/colons in LD_PRELOAD, without escaping. Reject an ambiguous checkout path.
    library = str(build / "libzvram_hip.so")
    if any(character.isspace() or character == ":" for character in library):
        parser.error("HIP checkout path must not contain spaces or colons")
    env["LD_PRELOAD"] = library + (" " + env["LD_PRELOAD"] if env.get("LD_PRELOAD") else "")
    if args.hip_vmm:
        env["ZVRAM_HIP_VMM"] = "1"
    if args.hip_report_capacity:
        env["ZVRAM_HIP_REPORT_CAPACITY"] = "1"
    if args.hip_local_mib is not None:
        env["ZVRAM_HIP_LOCAL_LIMIT_MIB"] = str(args.hip_local_mib)
    if args.hip_host_mib is not None:
        env["ZVRAM_HIP_HOST_LIMIT_MIB"] = str(args.hip_host_mib)
    if args.hip_auto_idle_ms is not None:
        registered = env.get("ROCPROFILER_REGISTER_LIBRARY")
        if registered and registered != library:
            parser.error("automatic hibernation needs the HIP dispatch bridge; an existing profiler library is configured")
        env["ROCPROFILER_REGISTER_LIBRARY"] = library
        env["ROCPROFILER_REGISTER_SECURE"] = "yes"
        env["ZVRAM_HIP_AUTO_IDLE_MS"] = str(args.hip_auto_idle_ms)
        env["ZVRAM_HIP_COLD_LIMIT_MIB"] = str(args.hip_cold_mib)
else:
    if args.vulkan_virtual_mib is not None:
        env["ZVRAM_VULKAN_VIRTUAL_MIB"] = str(args.vulkan_virtual_mib)
    if args.vulkan_auto_idle_ms is not None:
        env["ZVRAM_VULKAN_AUTO_IDLE_MS"] = str(args.vulkan_auto_idle_ms)
        env["ZVRAM_VULKAN_COLD_MIB"] = str(args.vulkan_cold_mib)
    if args.vulkan_min_savings_percent is not None:
        env["ZVRAM_VULKAN_MIN_SAVINGS_PERCENT"] = str(args.vulkan_min_savings_percent)
    if args.vulkan_byte_shuffle is not None:
        env["ZVRAM_VULKAN_BYTE_SHUFFLE"] = str(args.vulkan_byte_shuffle)
    env["ZVRAM_VULKAN_CODEC"] = effective_codec
    if args.vulkan_gdeflate_workers is not None:
        env["ZVRAM_VULKAN_GDEFLATE_WORKERS"] = str(args.vulkan_gdeflate_workers)
    if args.vulkan_bp16_workers is not None:
        env["ZVRAM_VULKAN_BP16_WORKERS"] = str(args.vulkan_bp16_workers)
    if args.vulkan_bp16_upload_workers is not None:
        env["ZVRAM_VULKAN_BP16_UPLOAD_WORKERS"] = str(args.vulkan_bp16_upload_workers)
    if gpu_restore:
        if gdeflate_gpu:
            env["ZVRAM_VULKAN_GDEFLATE_GPU"] = "1"
            env["ZVRAM_GDEFLATE_SHADER_PATH"] = str(build / "gdeflate-wave32.spv")
        if bp16_gpu:
            env["ZVRAM_VULKAN_BP16_GPU"] = "1"
            env["ZVRAM_BP16_SHADER_PATH"] = str(build / "bp16.spv")
            if env.get("ZVRAM_VULKAN_BP16_GPU_ENCODE") == "1":
                env["ZVRAM_BP16_ENCODE_ANALYZE_SHADER_PATH"] = str(build / "bp16-encode-analyze.spv")
                env["ZVRAM_BP16_ENCODE_PACK_SHADER_PATH"] = str(build / "bp16-encode-pack.spv")
    if args.vulkan_selective_restore:
        env["ZVRAM_VULKAN_SELECTIVE_RESTORE"] = "1"
    if args.vulkan_active_eviction:
        env["ZVRAM_VULKAN_ACTIVE_EVICTION"] = "1"
    if args.vulkan_range_mib is not None:
        env["ZVRAM_VULKAN_RANGE_MIB"] = str(args.vulkan_range_mib)
    if args.vulkan_resident_mib is not None:
        env["ZVRAM_VULKAN_RESIDENT_MIB"] = str(args.vulkan_resident_mib)
    if args.vulkan_async_compression:
        env["ZVRAM_VULKAN_ASYNC_COMPRESSION"] = "1"
    if args.vulkan_buffer_presentation:
        env["ZVRAM_VULKAN_BUFFER_PRESENTATION"] = "1"
    if args.vulkan_lazy_backing:
        env["ZVRAM_VULKAN_LAZY_BACKING"] = "1"
    if args.vulkan_headroom_mib is not None:
        env["ZVRAM_VULKAN_HEADROOM_MIB"] = str(args.vulkan_headroom_mib)
    if args.vulkan_resident_after_cold:
        env["ZVRAM_VULKAN_RESIDENT_AFTER_COLD"] = "1"
    if args.vulkan_eviction_policy is not None:
        env["ZVRAM_VULKAN_EVICTION_POLICY"] = args.vulkan_eviction_policy
    if args.vulkan_strict_robustness:
        env["ZVRAM_VULKAN_STRICT_ROBUSTNESS"] = "1"
    if args.vulkan_clean_cache:
        env["ZVRAM_VULKAN_CLEAN_CACHE"] = "1"
    if args.vulkan_clean_cache_mib is not None:
        env["ZVRAM_VULKAN_CLEAN_CACHE_MIB"] = str(args.vulkan_clean_cache_mib)
    layer_paths = [str(build)]
    if env.get("VK_LAYER_PATH"):
        layer_paths.extend(env["VK_LAYER_PATH"].split(os.pathsep))
    else:
        # Pressure Vessel imports VK_LAYER_PATH but drops VK_ADD_LAYER_PATH.
        layer_paths.extend(env.get("VK_ADD_LAYER_PATH", "").split(os.pathsep))
        config_home = env.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
        config_dirs = env.get("XDG_CONFIG_DIRS") or "/etc/xdg"
        data_home = env.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
        data_dirs = env.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
        layer_paths.append(str(Path(config_home) / "vulkan/explicit_layer.d"))
        layer_paths.extend(str(Path(path) / "vulkan/explicit_layer.d") for path in config_dirs.split(os.pathsep) if path)
        layer_paths.append(str(Path(data_home) / "vulkan/explicit_layer.d"))
        layer_paths.extend(str(Path(path) / "vulkan/explicit_layer.d") for path in data_dirs.split(os.pathsep) if path)
        layer_paths.extend(("/etc/vulkan/explicit_layer.d", "/usr/local/share/vulkan/explicit_layer.d",
                            "/usr/share/vulkan/explicit_layer.d"))
    env["VK_LAYER_PATH"] = os.pathsep.join(dict.fromkeys(path for path in layer_paths if path))
    layers = ["VK_LAYER_NX_zvram"]
    if args.validate:
        layers.append("VK_LAYER_KHRONOS_validation")
        env["VK_VALIDATION_VALIDATE_SYNC"] = "1"
    layers.extend(x for x in env.get("VK_INSTANCE_LAYERS", "").split(os.pathsep) if x and x not in layers)
    env["VK_INSTANCE_LAYERS"] = os.pathsep.join(layers)
if args.verbose:
    env["ZVRAM_VERBOSE"] = "1"
if args.isolate_layers:
    env["VK_LOADER_LAYERS_DISABLE"] = "~implicit~"
try:
    os.execvpe(command[0], command, env)
except OSError as error:
    print(f"zvram: {error}", file=sys.stderr)
    sys.exit(127 if isinstance(error, FileNotFoundError) else 126)
