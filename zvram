#!/usr/bin/env python3
"""Launch one process with the local zVram Vulkan or HIP backend."""
import argparse
import os
from pathlib import Path
import sys

parser = argparse.ArgumentParser(description="zVram experimental GPU memory launcher")
parser.add_argument("--hip", action="store_true", help="use the HIP allocation spillover backend instead of the Vulkan layer")
parser.add_argument("--hip-vmm", action="store_true", help="use HIP virtual memory for a single pointer backed by VRAM and RAM (experimental)")
parser.add_argument("--hip-report-capacity", action="store_true", help="report the configured VRAM plus GTT capacity through supported HIP queries (opt-in)")
parser.add_argument("--hip-local-mib", type=int, help="spill tracked HIP allocations beyond this local limit; 0 forces RAM backing")
parser.add_argument("--hip-host-mib", type=int, help="limit tracked mapped HIP host memory")
parser.add_argument("--hip-auto-idle-ms", type=int, help="automatically compress idle HIP VMM allocations (experimental, exact supported HIP ABI)")
parser.add_argument("--hip-cold-mib", type=int, help="limit automatic lossless cold storage; requires --hip-auto-idle-ms")
virtual_size = parser.add_mutually_exclusive_group()
virtual_size.add_argument("--vulkan-virtual-mib", type=int, help="set the experimental Vulkan logical heap size at launch, in positive MiB (requires sparse binding)")
virtual_size.add_argument("--vulkan-virtual-gib", type=int, help="set the experimental Vulkan logical heap size at launch, in positive GiB (requires sparse binding)")
parser.add_argument("--vulkan-auto-idle-ms", type=int, help="compress eligible idle Vulkan storage allocations after this delay (experimental)")
parser.add_argument("--vulkan-cold-mib", type=int, help="limit retained Vulkan snapshots in MiB; requires --vulkan-auto-idle-ms")
parser.add_argument("--vulkan-min-savings-percent", type=int, help="minimum snapshot savings 0..100; 0 keeps any saving, 100 uses raw snapshots; requires automatic snapshots")
parser.add_argument("--vulkan-selective-restore", action="store_true", help="restore only allocations referenced by tracked Vulkan submissions; unknown access restores all (experimental)")
parser.add_argument("--vulkan-active-eviction", action="store_true", help="compress unused whole Vulkan allocations while other tracked submissions remain active; requires selective restore (experimental)")
parser.add_argument("--vulkan-range-mib", type=int, help="enable sparse residency and chunk native pools at this positive MiB granularity; requires active eviction (experimental)")
parser.add_argument("--vulkan-resident-mib", type=int, help="limit eligible resident backing at tracked submission admission; requires range mode (experimental, not a global VRAM cap)")
parser.add_argument("--vulkan-resident-after-cold", action="store_true", help="arm resident admission after all eligible backing first becomes cold; startup can exceed limit")
parser.add_argument("--vulkan-eviction-policy", choices=("lru", "mru"), help="choose pressure victims: oldest first (default lru), or newest first for cyclic scans; requires resident admission")
parser.add_argument("--vulkan-strict-robustness", action="store_true", help="enable supported robustness2 bounds for narrow descriptor residency; requires range mode")
parser.add_argument("--vulkan-clean-cache", action="store_true", help="reuse retained snapshots after proven read-only work; shares cold-store budget and requires range mode")
parser.add_argument("--verbose", action="store_true", help="log each Vulkan allocation")
parser.add_argument("--validate", action="store_true", help="enable Vulkan core and synchronization validation")
parser.add_argument("--isolate-layers", action="store_true", help="disable implicit layers for a controlled experiment")
parser.add_argument("command", nargs=argparse.REMAINDER, help="-- application [arguments]")
args = parser.parse_args()
if args.vulkan_virtual_gib is not None:
    args.vulkan_virtual_mib = args.vulkan_virtual_gib * 1024
command = args.command
if command and command[0] == "--":
    command = command[1:]
if not command:
    parser.error("supply an application after --")
build = Path(__file__).resolve().parent / "build"
if args.hip and args.validate:
    parser.error("--validate applies to the Vulkan backend")
if args.vulkan_virtual_mib is not None:
    if args.hip or args.vulkan_virtual_mib <= 0:
        parser.error("--vulkan-virtual-mib requires the Vulkan backend and a positive size in MiB")
    if args.vulkan_virtual_mib > ((1 << 64) - 1) // (1024 * 1024):
        parser.error("--vulkan-virtual-mib overflows Vulkan's 64-bit byte size")
if args.vulkan_auto_idle_ms is not None:
    if args.hip or args.vulkan_virtual_mib is None or args.vulkan_cold_mib is None or not 1 <= args.vulkan_auto_idle_ms <= (1 << 32) - 1:
        parser.error("Vulkan automatic snapshots require --vulkan-virtual-mib, --vulkan-cold-mib, and idle a positive uint32 in ms")
if args.vulkan_min_savings_percent is not None and (
        args.hip or args.vulkan_auto_idle_ms is None or
        not 0 <= args.vulkan_min_savings_percent <= 100):
    parser.error("--vulkan-min-savings-percent requires Vulkan automatic snapshots and a value 0..100")
if args.vulkan_cold_mib is not None:
    if args.vulkan_auto_idle_ms is None or not 0 < args.vulkan_cold_mib <= ((1 << 64) - 1) // (1024 * 1024):
        parser.error("--vulkan-cold-mib requires automatic snapshots and a positive size fitting 64-bit bytes")
if args.vulkan_selective_restore and (args.hip or args.vulkan_auto_idle_ms is None):
    parser.error("--vulkan-selective-restore requires Vulkan automatic snapshots")
if args.vulkan_active_eviction and not args.vulkan_selective_restore:
    parser.error("--vulkan-active-eviction requires --vulkan-selective-restore")
if args.vulkan_range_mib is not None and (not args.vulkan_active_eviction or
        not 0 < args.vulkan_range_mib <= ((1 << 64) - 1) // (1024 * 1024)):
    parser.error("--vulkan-range-mib requires active eviction and a positive size fitting 64-bit bytes")
if args.vulkan_resident_mib is not None and (args.vulkan_range_mib is None or
        not 0 < args.vulkan_resident_mib <= ((1 << 64) - 1) // (1024 * 1024)):
    parser.error("--vulkan-resident-mib requires range mode and a positive size fitting 64-bit bytes")
if args.vulkan_strict_robustness and args.vulkan_range_mib is None:
    parser.error("--vulkan-strict-robustness requires --vulkan-range-mib")
if args.vulkan_resident_after_cold and args.vulkan_resident_mib is None:
    parser.error("--vulkan-resident-after-cold requires --vulkan-resident-mib")
if args.vulkan_eviction_policy is not None and args.vulkan_resident_mib is None:
    parser.error("--vulkan-eviction-policy requires --vulkan-resident-mib")
if args.vulkan_clean_cache and args.vulkan_range_mib is None:
    parser.error("--vulkan-clean-cache requires --vulkan-range-mib")
if not args.hip and (args.hip_vmm or args.hip_report_capacity or args.hip_local_mib is not None or args.hip_host_mib is not None or args.hip_auto_idle_ms is not None or args.hip_cold_mib is not None):
    parser.error("HIP virtual memory and memory limits require --hip")
if args.hip_report_capacity and (not args.hip_vmm or args.hip_local_mib is None or
                                 args.hip_host_mib is None or args.hip_host_mib <= 0):
    parser.error("--hip-report-capacity requires --hip-vmm and explicit local and positive host limits")
if args.hip_auto_idle_ms is not None and (not args.hip_vmm or args.hip_cold_mib is None or
                                       args.hip_local_mib is None or args.hip_host_mib is None or
                                       not 1 <= args.hip_auto_idle_ms <= 60000 or
                                       not 1 <= args.hip_cold_mib <= 40960):
    parser.error("automatic hibernation requires --hip-vmm, explicit local/host limits, idle 1..60000 ms, and cold storage 1..40960 MiB")
if args.hip_cold_mib is not None and args.hip_auto_idle_ms is None:
    parser.error("--hip-cold-mib requires --hip-auto-idle-ms")
for limit in (args.hip_local_mib, args.hip_host_mib):
    if limit is not None and not 0 <= limit <= 40960:
        parser.error("HIP memory limits must be 0..40960 MiB")
if args.hip and not (build / "libzvram_hip.so").is_file():
    parser.error("HIP backend missing; install ROCm development tools and rebuild")
if not args.hip and (not (build / "VK_LAYER_NX_zvram.json").is_file() or not (build / "libzvram_layer.so").is_file()):
    parser.error("build first: cmake -S zvram -B zvram/build && cmake --build zvram/build")
env = os.environ.copy()
if args.hip:
    # The loader accepts spaces/colons in LD_PRELOAD, without escaping. Reject an ambiguous checkout path.
    library = str(build / "libzvram_hip.so")
    if any(character.isspace() or character == ":" for character in library):
        parser.error("HIP checkout path must not contain spaces or colons")
    env["LD_PRELOAD"] = library + (" " + env["LD_PRELOAD"] if env.get("LD_PRELOAD") else "")
    if args.hip_vmm:
        env["ZVRAM_HIP_VMM"] = "1"
    if args.hip_report_capacity:
        env["ZVRAM_HIP_REPORT_CAPACITY"] = "1"
    if args.hip_local_mib is not None:
        env["ZVRAM_HIP_LOCAL_LIMIT_MIB"] = str(args.hip_local_mib)
    if args.hip_host_mib is not None:
        env["ZVRAM_HIP_HOST_LIMIT_MIB"] = str(args.hip_host_mib)
    if args.hip_auto_idle_ms is not None:
        registered = env.get("ROCPROFILER_REGISTER_LIBRARY")
        if registered and registered != library:
            parser.error("automatic hibernation needs the HIP dispatch bridge; an existing profiler library is configured")
        env["ROCPROFILER_REGISTER_LIBRARY"] = library
        env["ROCPROFILER_REGISTER_SECURE"] = "yes"
        env["ZVRAM_HIP_AUTO_IDLE_MS"] = str(args.hip_auto_idle_ms)
        env["ZVRAM_HIP_COLD_LIMIT_MIB"] = str(args.hip_cold_mib)
else:
    if args.vulkan_virtual_mib is not None:
        env["ZVRAM_VULKAN_VIRTUAL_MIB"] = str(args.vulkan_virtual_mib)
    if args.vulkan_auto_idle_ms is not None:
        env["ZVRAM_VULKAN_AUTO_IDLE_MS"] = str(args.vulkan_auto_idle_ms)
        env["ZVRAM_VULKAN_COLD_MIB"] = str(args.vulkan_cold_mib)
    if args.vulkan_min_savings_percent is not None:
        env["ZVRAM_VULKAN_MIN_SAVINGS_PERCENT"] = str(args.vulkan_min_savings_percent)
    if args.vulkan_selective_restore:
        env["ZVRAM_VULKAN_SELECTIVE_RESTORE"] = "1"
    if args.vulkan_active_eviction:
        env["ZVRAM_VULKAN_ACTIVE_EVICTION"] = "1"
    if args.vulkan_range_mib is not None:
        env["ZVRAM_VULKAN_RANGE_MIB"] = str(args.vulkan_range_mib)
    if args.vulkan_resident_mib is not None:
        env["ZVRAM_VULKAN_RESIDENT_MIB"] = str(args.vulkan_resident_mib)
    if args.vulkan_resident_after_cold:
        env["ZVRAM_VULKAN_RESIDENT_AFTER_COLD"] = "1"
    if args.vulkan_eviction_policy is not None:
        env["ZVRAM_VULKAN_EVICTION_POLICY"] = args.vulkan_eviction_policy
    if args.vulkan_strict_robustness:
        env["ZVRAM_VULKAN_STRICT_ROBUSTNESS"] = "1"
    if args.vulkan_clean_cache:
        env["ZVRAM_VULKAN_CLEAN_CACHE"] = "1"
    path_variable = "VK_LAYER_PATH" if env.get("VK_LAYER_PATH") else "VK_ADD_LAYER_PATH"
    env[path_variable] = str(build) + (os.pathsep + env[path_variable] if env.get(path_variable) else "")
    layers = ["VK_LAYER_NX_zvram"]
    if args.validate:
        layers.append("VK_LAYER_KHRONOS_validation")
        env["VK_VALIDATION_VALIDATE_SYNC"] = "1"
    layers.extend(x for x in env.get("VK_INSTANCE_LAYERS", "").split(os.pathsep) if x and x not in layers)
    env["VK_INSTANCE_LAYERS"] = os.pathsep.join(layers)
if args.verbose:
    env["ZVRAM_VERBOSE"] = "1"
if args.isolate_layers:
    env["VK_LOADER_LAYERS_DISABLE"] = "~implicit~"
try:
    os.execvpe(command[0], command, env)
except OSError as error:
    print(f"zvram: {error}", file=sys.stderr)
    sys.exit(127 if isinstance(error, FileNotFoundError) else 126)
