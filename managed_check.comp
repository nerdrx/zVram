#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer Data { uint words[]; } data;
layout(push_constant) uniform Parameters { uint count; uint salt; uint patternMode; } p;
uint mix32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    return x ^ (x >> 16);
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count) data.words[i] ^= p.patternMode != 0 ? mix32(i ^ p.salt) : p.salt;
}
