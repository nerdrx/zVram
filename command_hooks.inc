    if (std::strcmp(name, "vkCmdSetAttachmentFeedbackLoopEnableEXT") == 0) return reinterpret_cast<PFN_vkVoidFunction>(trackedvkCmdSetAttachmentFeedbackLoopEnableEXT);
#endif
#if (defined(VK_VERSION_1_0))
    if (std::strcmp(name, "vkCmdSetViewport") == 0) return reinterpret_cast<PFN_vkVoidFunction>(trackedvkCmdSetViewport);
#endif
