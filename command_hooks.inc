    if (!name) return nullptr;
#if (defined(VK_VERSION_1_0))
    if (std::strcmp(name, "vkCmdBindPipeline") == 0) return reinterpret_cast<PFN_vkVoidFunction>(trackedvkCmdBindPipeline);
